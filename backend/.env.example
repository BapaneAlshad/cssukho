# Server only. Copy the Transaction pooler URI from the new Supabase project.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Instagram API with Instagram Login. Set these only in Vercel; never ship them in the APK.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://sukho-ramen-api.vercel.app/api/instagram-callback
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Optional overrides for a Meta app using a different API version or test endpoint.
INSTAGRAM_API_VERSION=v27.0
INSTAGRAM_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_GRAPH_URL=https://graph.instagram.com
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages
